                        "code": [
                            "114: def test_login_post_bad_credentials_renders_login_with_401():",
                            "115:     \"\"\"",
                            "116:     **Feature: consumer UI e2e tier-2 T15.2**",
                            "117:     **Property: POST /login with the right username but",
                            "118:     the wrong password re-renders the login form with status",
                            "119:     401 and a generic \"Invalid username or password\" flash --",
                            "120:     the response must NOT leak that the username exists.**",
                            "121:     \"\"\"",
                            "122:     handle = ensure_app()",
                            "123:     admin = ensure_seeded_admin()",
                            "124:     response, cookies = login_via_post(",
                            "125:         wsgi_app=handle.wsgi_app,",
                            "126:         login=admin.login,",
                            "127:         password=\"wrong-password-{}\".format(secrets.token_hex(4)),",
                            "128:     )",
                            "129:     testbase.assert_equal(response.status_code, 401)",
                            "130:     body = response.text",
                            "131:     has_form = \"<form\" in body",
                            "132:     testbase.assert_equal(has_form, True)",
                            "133:     has_invalid_message = \"Invalid username or password\" in body",
                            "134:     testbase.assert_equal(has_invalid_message, True)",
                            "135:     # The body must NOT carry user_id; an unauthenticated session",
                            "136:     # cookie may still be set (for the flash + CSRF) but its",
                            "137:     # payload must not include a SESSION_USER_ID_KEY.",
                            "138:     if cookie_session.COOKIE_NAME in cookies:",
                            "139:         payload = decode_session_cookie(",
                            "140:             cookie_value=cookies[cookie_session.COOKIE_NAME]",
                            "141:         )",
                            "142:         if payload is not None:",
                            "143:             testbase.assert_equal(",
                            "144:                 payload.get(auth_guard.SESSION_USER_ID_KEY), None",
                            "145:             )",
                            "146:     return"
                        ],
                        "context": null
                    },
                    {
