                        "code": [
                            "072: def test_admin_and_viewer_can_hold_concurrent_sessions():",
                            "073:     \"\"\"",
                            "074:     **Feature: consumer UI tier-4 T19.1**",
                            "075:     **Property: An admin and a viewer can be logged in",
                            "076:     simultaneously; each cookie jar drives its own dashboard",
                            "077:     request without cross-talk. Decoded payloads from the two",
                            "078:     cookies carry distinct ``user_id`` / ``session_token``",
                            "079:     values, proving the modern :class:`AuthSession` rows are",
                            "080:     independent.**",
                            "081:     \"\"\"",
                            "082:     handle = ensure_app()",
                            "083:     admin = ensure_seeded_admin()",
                            "084:     viewer = ensure_seeded_viewer()",
                            "085: ",
                            "086:     admin_cookies = login_as(wsgi_app=handle.wsgi_app, user=admin)",
                            "087:     viewer_cookies = login_as(wsgi_app=handle.wsgi_app, user=viewer)",
                            "088: ",
                            "089:     admin_payload = decode_session_cookie(",
                            "090:         cookie_value=admin_cookies[cookie_session.COOKIE_NAME]",
                            "091:     )",
                            "092:     viewer_payload = decode_session_cookie(",
                            "093:         cookie_value=viewer_cookies[cookie_session.COOKIE_NAME]",
                            "094:     )",
                            "095:     testbase.assert_equal(",
                            "096:         admin_payload[auth_guard.SESSION_USER_ID_KEY] !=",
                            "097:         viewer_payload[auth_guard.SESSION_USER_ID_KEY],",
                            "098:         True,",
                            "099:     )",
                            "100:     testbase.assert_equal(",
                            "101:         admin_payload[auth_guard.SESSION_TOKEN_KEY] !=",
                            "102:         viewer_payload[auth_guard.SESSION_TOKEN_KEY],",
                            "103:         True,",
                            "104:     )",
                            "105: ",
                            "106:     # Each cookie reaches its own dashboard.",
                            "107:     admin_response = drive_request(",
                            "108:         wsgi_app=handle.wsgi_app,",
                            "109:         method=\"GET\",",
                            "110:         path=\"/admin/dashboard\",",
                            "111:         cookies=admin_cookies,",
                            "112:     )",
                            "113:     viewer_response = drive_request(",
                            "114:         wsgi_app=handle.wsgi_app,",
                            "115:         method=\"GET\",",
                            "116:         path=\"/admin/dashboard\",",
                            "117:         cookies=viewer_cookies,",
                            "118:     )",
                            "119:     testbase.assert_equal(admin_response.status_code, 200)",
                            "120:     testbase.assert_equal(viewer_response.status_code, 200)",
                            "121: ",
                            "122:     # And neither response leaks the OTHER user's username",
                            "123:     # into its own body.",
                            "124:     testbase.assert_equal(",
                            "125:         viewer.login in admin_response.text, False",
                            "126:     )",
                            "127:     testbase.assert_equal(",
