                            "lineno": 309,
                            "scope": "test_production_startup_completes_against_alembic_migrated_db"
                        },
                        "call": "test_production_startup_completes_against_alembic_migrated_db()",
                        "code": [
                            "173: def test_production_startup_completes_against_alembic_migrated_db():",
                            "174:     \"\"\"",
                            "175:     **Feature: production startup smoke T18.1**",
                            "176:     **Property: ``build_wsgi_application_for_production()``",
                            "177:     completes end-to-end against a fresh SQLite database",
                            "178:     whose schema came from ``alembic upgrade head`` -- every",
                            "179:     REST + UI registrar imports cleanly, every Phase-1..6",
                            "180:     builtin extension registers cleanly, the lifecycle",
                            "181:     advances to ``INFRASTRUCTURE_READY``, and the resulting",
                            "182:     WSGI app answers a probe to ``GET /`` with a 2xx",
                            "183:     response.",
                            "184: ",
                            "185:     Runs the bootstrap in a subprocess so the production",
                            "186:     persona singleton stays isolated from the rest of the",
                            "187:     test suite.**",
                            "188:     \"\"\"",
                            "189:     # Set up the per-run scratch state: tempfile DB + tempfile",
                            "190:     # KEK. Both get deleted at the end.",
                            "191:     db_fd, db_path = tempfile.mkstemp(",
                            "192:         prefix=\"pych-smoke-db-\", suffix=\".sqlite\",",
                            "193:     )",
                            "194:     os.close(db_fd)",
                            "195:     try:",
                            "196:         os.unlink(db_path)",
                            "197:     except OSError:",
                            "198:         pass",
                            "199: ",
                            "200:     kek_fd, kek_path = tempfile.mkstemp(",
                            "201:         prefix=\"pych-smoke-kek-\", suffix=\".bin\",",
                            "202:     )",
                            "203:     try:",
                            "204:         os.write(kek_fd, b\"\\x77\" * 32)",
                            "205:     finally:",
                            "206:         os.close(kek_fd)",
                            "207: ",
                            "208:     repo_root = _repo_root()",
                            "209:     db_url = \"sqlite:///\" + db_path",
                            "210: ",
                            "211:     env = os.environ.copy()",
                            "212:     env[\"PYCHESTRATE_DATABASE_URL\"] = db_url",
                            "213:     env[\"PYCHESTRATE_RUNTIME_ENVIRONMENT\"] = \"testing\"",
                            "214:     env[\"PYCHESTRATE_AUTO_CREATE_SCHEMA\"] = \"false\"",
                            "215:     env[\"PYCHESTRATE_KEK_SOURCE\"] = \"file\"",
                            "216:     env[\"PYCHESTRATE_KEK_ID\"] = \"smoke-test-kek\"",
                            "217:     env[\"PYCHESTRATE_KEK_FILE_PATH\"] = kek_path",
                            "218:     # Pepper + UI cookie secret are optional in the bootstrap",
                            "219:     # config (the runtime tolerates them being unset).",
                            "220:     env.pop(\"PYCHESTRATE_PEPPER_SOURCE\", None)",
                            "221:     env.pop(\"PYCHESTRATE_PEPPER_FILE_PATH\", None)",
                            "222:     env.pop(\"PYCHESTRATE_PEPPER_ENV_VAR\", None)",
                            "223:     env.pop(\"PYCHESTRATE_UI_COOKIE_SECRET_SOURCE\", None)",
                            "224:     env.pop(\"PYCHESTRATE_UI_COOKIE_SECRET_FILE_PATH\", None)",
                            "225:     env.pop(\"PYCHESTRATE_UI_COOKIE_SECRET_ENV_VAR\", None)",
                            "226: ",
                            "227:     try:",
                            "228:         # Step 1: alembic upgrade head against the fresh DB.",
                            "229:         # Use the ``alembic`` console script rather than",
                            "230:         # ``python -m alembic`` -- the repo root contains an",
                            "231:         # ``alembic/`` migrations dir (configured in",
                            "232:         # alembic.ini), and ``-m alembic`` from repo root has",
                            "233:         # Python's namespace-package search resolve it to that",
                            "234:         # local dir, shadowing the installed library.",
                            "235:         alembic_script = os.path.join(",
                            "236:             os.path.dirname(sys.executable), \"alembic\"",
                            "237:         )",
                            "238:         upgrade_proc = subprocess.run(",
                            "239:             [alembic_script, \"upgrade\", \"head\"],",
                            "240:             cwd=repo_root,",
                            "241:             env=env,",
                            "242:             capture_output=True,",
                            "243:             text=True,",
                            "244:         )",
                            "245:         if upgrade_proc.returncode != 0:",
                            "246:             err_msg_lines = [\"alembic upgrade head failed.\"]",
                            "247:             err_msg_lines.append(\"STDOUT:\")",
                            "248:             err_msg_lines.append(upgrade_proc.stdout)",
                            "249:             err_msg_lines.append(\"STDERR:\")",
                            "250:             err_msg_lines.append(upgrade_proc.stderr)",
                            "251:             err_msg = os.linesep.join(err_msg_lines)",
                            "252:             raise AssertionError(err_msg)",
                            "253: ",
                            "254:         # Step 2: drive the production startup in a subprocess.",
                            "255:         driver_script = _DRIVER_SCRIPT_TEMPLATE.format(",
                            "256:             repo_root=repo_root,",
                            "257:         )",
                            "258:         startup_proc = subprocess.run(",
                            "259:             [sys.executable, \"-c\", driver_script],",
                            "260:             cwd=repo_root,",
                            "261:             env=env,",
                            "262:             capture_output=True,",
                            "263:             text=True,",
                            "264:             timeout=120,",
                            "265:         )",
                            "266:     finally:",
                            "267:         try:",
                            "268:             os.unlink(db_path)",
                            "269:         except OSError:",
                            "270:             pass",
                            "271:         try:",
                            "272:             os.unlink(kek_path)",
                            "273:         except OSError:",
                            "274:             pass",
                            "275: ",
                            "276:     # Step 3: assert on the subprocess output. Build a",
                            "277:     # diagnostic message that's useful in the failure case;",
                            "278:     # too many things can go wrong end-to-end and a bare",
                            "279:     # ``assert_equal(returncode, 0)`` doesn't help.",
                            "280:     err_msg_lines = []",
                            "281:     err_msg_lines.append(",
                            "282:         \"production startup smoke failed.\"",
                            "283:     )",
                            "284:     err_msg_lines.append(",
                            "285:         \"RETURNCODE: {}\".format(startup_proc.returncode)",
                            "286:     )",
                            "287:     err_msg_lines.append(\"STDOUT:\")",
                            "288:     err_msg_lines.append(startup_proc.stdout)",
                            "289:     err_msg_lines.append(\"STDERR:\")",
                            "290:     err_msg_lines.append(startup_proc.stderr)",
                            "291:     err_msg = os.linesep.join(err_msg_lines)",
                            "292: ",
