                            "108:     testbase.assert_equal(has_form_open, True)",
                            "109:     testbase.assert_equal(has_username_field, True)",
                            "110:     testbase.assert_equal(has_password_field, True)",
                            "111:     # The Content-Type header must come back as HTML even though",
