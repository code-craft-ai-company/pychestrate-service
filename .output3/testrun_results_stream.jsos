                        "code": [
                            "854: def grant_role_to_user(",
                            "855:         *, user_id: str, role_name: str",
                            "856:     ) -> None:",
                            "857:     \"\"\"",
                            "858:         Idempotently bind ``role_name`` to ``user_id`` at SYSTEM",
                            "859:         scope on the modern :mod:`security.rbac` schema.",
                            "860: ",
                            "861:         Looks up (or creates) the :class:`RbacRole` row matching",
                            "862:         ``role_name``, then inserts an",
                            "863:         :class:`RbacRoleBinding` with ``principal_kind=USER``",
                            "864:         and ``scope_kind=SYSTEM`` for the user. The role-to-",
                            "865:         permissions edges come from the in-tree",
                            "866:         :class:`SystemAdminRole` / :class:`AuditorRole` /",
                            "867:         ``Project*Role`` packs at evaluator time -- the",
                            "868:         evaluator reads the catalog produced by",
                            "869:         :func:`load_catalog_from_registry`, so the database",
                            "870:         only needs the role + binding rows seeded.",
                            "871: ",
                            "872:         :param user_id: User id (UUID string).",
                            "873:         :param role_name: Role name; must match a registered",
                            "874:                           :class:`RoleExtension` ``role_name``.",
                            "875:     \"\"\"",
                            "876:     from automojo.pychestrate.webservice.security.rbac.models import (  # noqa: E402",
                            "877:         BindingScope,",
                            "878:         PrincipalKind,",
                            "879:         RbacRole,",
                            "880:         RbacRoleBinding,",
                            "881:         RoleSource,",
                            "882:     )",
                            "883:     factory = SITE_SHARED_GLOBALS.DATABASE_SESSION_FACTORY",
                            "884:     db_session = factory()",
                            "885:     try:",
                            "886:         role = (",
                            "887:             db_session.query(RbacRole)",
                            "888:             .filter(RbacRole.role_name == role_name)",
                            "889:             .first()",
                            "890:         )",
                            "891:         if role is None:",
                            "892:             role = RbacRole(",
                            "893:                 role_id=uuid.uuid4(),",
                            "894:                 role_name=role_name,",
                            "895:                 source=RoleSource.BUILTIN,",
                            "896:                 source_name=role_name,",
                            "897:                 description=\"seeded by e2e harness\",",
                            "898:             )",
                            "899:             db_session.add(role)",
                            "900:             db_session.flush()",
                            "901: ",
                            "902:         principal_uuid = uuid.UUID(user_id)",
                            "903:         existing_binding = (",
                            "904:             db_session.query(RbacRoleBinding)",
                            "905:             .filter(",
                            "906:                 RbacRoleBinding.role_id == role.role_id,",
                            "907:                 RbacRoleBinding.principal_kind == PrincipalKind.USER,",
                            "908:                 RbacRoleBinding.principal_id == principal_uuid,",
                            "909:                 RbacRoleBinding.scope_kind == BindingScope.SYSTEM,",
                            "910:                 RbacRoleBinding.scope_id.is_(None),",
                            "911:             )",
                            "912:             .first()",
                            "913:         )",
                            "914:         if existing_binding is None:",
                            "915:             binding = RbacRoleBinding(",
                            "916:                 binding_id=uuid.uuid4(),",
                            "917:                 role_id=role.role_id,",
                            "918:                 principal_kind=PrincipalKind.USER,",
                            "919:                 principal_id=principal_uuid,",
                            "920:                 scope_kind=BindingScope.SYSTEM,",
                            "921:                 scope_id=None,",
                            "922:                 inherits_into_project=False,",
                            "923:             )",
                            "924:             db_session.add(binding)",
                            "925: ",
                            "926:         db_session.commit()",
                            "927:     finally:",
                            "928:         try:",
                            "929:             db_session.close()",
                            "930:         except Exception:",
                            "931:             pass",
                            "932:     return"
                        ],
