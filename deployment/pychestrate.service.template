# pychestrate-service alpha (gunicorn) -- systemd unit
#
# Rendered + installed by ``deployment/deploy-alpha-to-host.sh``.
# Placeholders:
#   @USER@   -- the deploy user (e.g. myron)
#   @PORT@   -- the loopback bind port (e.g. 8888)
#
# After install:
#   sudo systemctl daemon-reload
#   sudo systemctl enable pychestrate.service
#   sudo systemctl restart pychestrate.service
#   sudo journalctl -u pychestrate.service -f
#
# Operator commands:
#   systemctl status   pychestrate.service
#   systemctl stop     pychestrate.service
#   systemctl restart  pychestrate.service
#   journalctl -u pychestrate.service -n 200 --no-pager
[Unit]
Description=pychestrate-service (alpha, gunicorn)
Documentation=https://github.com/automationmojo/pychestrate-service
After=network-online.target
Wants=network-online.target

# Restart back-off lives in [Unit] -- systemd silently ignores
# StartLimitIntervalSec when it's placed under [Service] (it
# warns in the journal but never enforces the limit). With it
# here, 5 crashes inside 30 seconds halt the restart loop.
StartLimitBurst=5
StartLimitIntervalSec=30

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=/home/@USER@/pychestrate-service

# ``run-staging-gunicorn`` auto-generates the per-checkout dev
# secrets on first run, sets PYCHESTRATE_* env, and execs
# gunicorn against build_wsgi_application_for_production().
# The systemd-injected env vars below override the script's
# defaults so we always bind 127.0.0.1 + the chosen port.
Environment="PYCHESTRATE_RUNTIME_ENVIRONMENT=staging"
Environment="PYCHESTRATE_BIND_HOST=127.0.0.1"
Environment="PYCHESTRATE_BIND_PORT=@PORT@"
Environment="PYCHESTRATE_AUTO_CREATE_SCHEMA=false"

# Pychestrate "presence directory" -- the canonical home for
# the application's per-host state. Holds:
#
#   * settings.config          -- this_app variable overrides
#   * pychestrate.sqlite       -- alpha-tier persistent DB
#   * initial-admin-token      -- mode 0600, written on first
#                                  boot by the setup wizard
#   * artifacts/               -- run artifacts (result trees
#                                  uploaded by pods); override
#                                  with PYCHESTRATE_ARTIFACT_ROOT
#                                  below.  Never inside the
#                                  checkout: ProtectHome mounts
#                                  it read-only and every deploy
#                                  rsyncs it with --delete.
#   * backups/, backup-keys/   -- backup archives and their key
#                                  bundles (POST /api/v1/backups
#                                  and pychestrate-backup.timer);
#                                  copy both off the host.
#   * logs/                    -- future home for application
#                                  logs (the alpha still tees
#                                  gunicorn stdout to
#                                  ~/.pychestrate/server.log)
#
# Resolved at entrypoint time by ``pychestrate_presence.
# resolve_presence_dir``: CLI flag ``--presence-dir`` first, then
# ``PYCHESTRATE_PRESENCE_DIR`` env var, then the pychestrate
# default ``~/pychestrate``. With no override the default lands
# under the service user's $HOME, which:
#
#   * survives ``development/setup-environment reset`` (which
#     wipes the checkout's .cache/)
#   * needs no sudo to create (lives in $HOME)
#
# Uncomment + set PYCHESTRATE_PRESENCE_DIR below to relocate to a
# system-wide path like /var/lib/pychestrate (requires that the
# operator pre-create the directory mode 0700 owned by the
# service user).
#
#Environment="PYCHESTRATE_PRESENCE_DIR=/var/lib/pychestrate"

# Run-artifact root.  Defaults to <presence dir>/artifacts, which
# the ReadWritePaths line below already covers.  Relocating it
# (e.g. to a larger volume) needs that path added to
# ReadWritePaths as well, or uploads fail with EROFS.
#
#Environment="PYCHESTRATE_ARTIFACT_ROOT=/srv/pychestrate/artifacts"

# Monitoring.  /livez and /readyz answer without credentials.
# /metrics (Prometheus) requires ``Authorization: Bearer <token>``
# with the token in PYCHESTRATE_METRICS_TOKEN_FILE, which
# run-staging-gunicorn generates at .cache/dev-secrets/dev.metrics-token
# (point the scraper's credentials_file at a copy).  To serve
# /metrics without a token instead -- e.g. when the proxy restricts
# the path -- set PYCHESTRATE_METRICS_PUBLIC=true.
#
#Environment="PYCHESTRATE_METRICS_TOKEN_FILE=/etc/pychestrate/metrics-token"
#Environment="PYCHESTRATE_METRICS_PUBLIC=true"

ExecStart=/home/@USER@/pychestrate-service/development/run-staging-gunicorn

# Restart on crash with a small backoff; the StartLimitBurst /
# StartLimitIntervalSec ceiling that halts repeated crashes
# lives in [Unit] above (systemd requires it there).
Restart=on-failure
RestartSec=5

# Tee the service's stdout/stderr to a log file under the
# user's home directory so ``tail -f ~/.pychestrate/server.log``
# stays useful for ad-hoc debugging.  ``journalctl -u
# pychestrate.service`` shows the unit's lifecycle.  The file is
# rotated daily (or past 100 MB, 14 kept, compressed) by
# /etc/logrotate.d/pychestrate from pychestrate.logrotate.template.
StandardOutput=append:/home/@USER@/.pychestrate/server.log
StandardError=append:/home/@USER@/.pychestrate/server.log

# Graceful shutdown: gunicorn handles SIGTERM by stopping
# accepts and letting in-flight requests finish (capped by
# this timeout).
KillSignal=SIGTERM
TimeoutStopSec=30

# Hardening (lightweight; tighten further as the deployment
# matures).
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/@USER@/pychestrate-service/.cache /home/@USER@/.pychestrate /home/@USER@/pychestrate

[Install]
WantedBy=multi-user.target
