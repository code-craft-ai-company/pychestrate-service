#!/usr/bin/env bash
#
# Boot a SQLite-backed STAGING Pychestrate webservice via
# gunicorn against ``build_wsgi_application_for_production()``.
#
# Differences from ``development/dev-up``:
#
#   * Uses gunicorn (production WSGI server) rather than the
#     dev server.
#   * ``PYCHESTRATE_AUTO_CREATE_SCHEMA`` defaults to ``false`` --
#     the schema is alembic-managed.  ``alembic upgrade head``
#     must have been run before invoking this script.
#   * ``PYCHESTRATE_RUNTIME_ENVIRONMENT`` defaults to
#     ``staging`` (not ``development``).
#   * Default bind is ``127.0.0.1:8888`` because the alpha
#     deploy puts an nginx reverse proxy on the public-facing
#     interface.  Override via the standard
#     ``PYCHESTRATE_BIND_HOST`` / ``PYCHESTRATE_BIND_PORT`` env
#     vars when invoking by hand.
#
# Generates a per-checkout 32-byte KEK + password pepper +
# UI cookie secret under ``.cache/dev-secrets/`` (gitignored,
# mode 0600) on first run and reuses them on subsequent runs.
# These are dev-tier secrets -- they are NOT suitable for a
# production deployment.  For a real production install,
# operators should set ``PYCHESTRATE_KEK_FILE_PATH`` / etc to
# operator-managed paths under ``/etc/pychestrate/keys`` and
# leave the auto-generation step inert.
#
# Refuses to run with ``PYCHESTRATE_RUNTIME_ENVIRONMENT=production``
# so an operator who copy-pastes never accidentally points this
# at a real database.
#
# Usage::
#
#   PYCHESTRATE_BIND_HOST=127.0.0.1 \
#   PYCHESTRATE_BIND_PORT=8888 \
#       development/run-staging-gunicorn
#
#   development/run-staging-gunicorn admin backup create --keep 14
#       Runs the operator command line (``python -m
#       ccai.pychestrate.admin ...``) under the same composed
#       environment instead of gunicorn, so a backup or restore sees
#       exactly the database, presence directory and key files the
#       service uses.  Admin mode never generates missing secrets --
#       on a rebuilt host the restore puts the backed-up keys there.

set -euo pipefail

cd "$(dirname "$0")/.."
REPO_ROOT="$(pwd)"

ADMIN_MODE="false"
if [[ "${1:-}" == "admin" ]]; then
    ADMIN_MODE="true"
    shift
fi

# ----------------------------------------------------------------------------
# Refuse production
# ----------------------------------------------------------------------------

if [[ "${PYCHESTRATE_RUNTIME_ENVIRONMENT:-}" == "production" ]]; then
    echo "run-staging-gunicorn refuses to run with PYCHESTRATE_RUNTIME_ENVIRONMENT=production." >&2
    echo "Unset the variable, or use development/run-website.sh for production." >&2
    exit 1
fi

# ----------------------------------------------------------------------------
# Per-checkout dev secret material (KEK + pepper + cookie secret)
# Mirrors the logic in development/dev-up so re-running picks up
# previously-generated material.
# ----------------------------------------------------------------------------

SECRETS_DIR="${REPO_ROOT}/.cache/dev-secrets"
mkdir -p "${SECRETS_DIR}"

KEK_FILE="${SECRETS_DIR}/dev.kek"
PEPPER_FILE="${SECRETS_DIR}/dev.password-pepper"
UI_COOKIE_SECRET_FILE="${SECRETS_DIR}/dev.ui-cookie-secret"
# Base64-encoded 32-byte Ed25519 seed for the job-envelope signer.
# The loader (jobs/envelope/signer.py) decodes base64 then builds
# the Ed25519 private key from the 32-byte seed.
ENVELOPE_SIGNING_KEY_FILE="${SECRETS_DIR}/dev.envelope-signing-key"
# Bearer token Prometheus sends to scrape /metrics (see
# system/operations.py); configure the scraper with this file.
METRICS_TOKEN_FILE="${SECRETS_DIR}/dev.metrics-token"

if [[ "${ADMIN_MODE}" == "false" ]]; then

if [[ ! -s "${METRICS_TOKEN_FILE}" ]]; then
    head -c 32 /dev/urandom | base64 | tr -d '/+=\n' > "${METRICS_TOKEN_FILE}"
    chmod 600 "${METRICS_TOKEN_FILE}"
    echo "run-staging-gunicorn: generated ${METRICS_TOKEN_FILE} (/metrics scrape token)"
fi

if [[ ! -s "${KEK_FILE}" ]]; then
    head -c 32 /dev/urandom > "${KEK_FILE}"
    chmod 600 "${KEK_FILE}"
    echo "run-staging-gunicorn: generated ${KEK_FILE} (32 random bytes)"
fi

if [[ ! -s "${ENVELOPE_SIGNING_KEY_FILE}" ]]; then
    head -c 32 /dev/urandom | base64 > "${ENVELOPE_SIGNING_KEY_FILE}"
    chmod 600 "${ENVELOPE_SIGNING_KEY_FILE}"
    echo "run-staging-gunicorn: generated ${ENVELOPE_SIGNING_KEY_FILE} (base64 Ed25519 seed)"
fi

if [[ ! -s "${PEPPER_FILE}" ]]; then
    head -c 32 /dev/urandom > "${PEPPER_FILE}"
    chmod 600 "${PEPPER_FILE}"
    echo "run-staging-gunicorn: generated ${PEPPER_FILE} (32 random bytes)"
fi

if [[ ! -s "${UI_COOKIE_SECRET_FILE}" ]]; then
    head -c 32 /dev/urandom > "${UI_COOKIE_SECRET_FILE}"
    chmod 600 "${UI_COOKIE_SECRET_FILE}"
    echo "run-staging-gunicorn: generated ${UI_COOKIE_SECRET_FILE} (32 random bytes)"
fi

fi  # ADMIN_MODE == false

# ----------------------------------------------------------------------------
# SQLite DB path (alembic-managed; auto-create disabled in staging)
#
# The DB lives in the pychestrate "presence directory" -- the
# persona default registered by ``establish_webapp_persona``
# (``~/pychestrate``).  ``setup-environment reset`` cannot touch
# this path (it only wipes the checkout's .cache/), and the alpha
# deploy script's step 6 alembic targets the same file.
#
# ``PYCHESTRATE_DATABASE_URL`` below is intentionally NOT exported.
# When unset, the runtime's ``DATASTORAGE`` variable accessor
# computes ``sqlite:///<presence-dir>/pychestrate.sqlite`` lazily
# from the persona singleton -- the operator does not have to keep
# this shell script in sync with the python-side default.
# ----------------------------------------------------------------------------

PRESENCE_DIR="${HOME}/pychestrate"
mkdir -p "${PRESENCE_DIR}"
chmod 0700 "${PRESENCE_DIR}" 2>/dev/null || true
DEV_DB_PATH="${PRESENCE_DIR}/pychestrate.sqlite"

# ----------------------------------------------------------------------------
# Compose the runtime env
# ----------------------------------------------------------------------------

export PYCHESTRATE_RUNTIME_ENVIRONMENT="${PYCHESTRATE_RUNTIME_ENVIRONMENT:-staging}"
# Unbuffered stdout: under systemd / nohup it is a file, and buffered
# startup lines (the initial-admin token path) could stay unwritten.
export PYTHONUNBUFFERED="${PYTHONUNBUFFERED:-1}"
# PYCHESTRATE_DATABASE_URL is left UNSET on purpose -- the runtime
# computes the persona-derived default. Operators who want a
# different URL (e.g. Postgres) should set it in the systemd
# unit's ``Environment=`` block, not here.
export PYCHESTRATE_AUTO_CREATE_SCHEMA="${PYCHESTRATE_AUTO_CREATE_SCHEMA:-false}"

export PYCHESTRATE_KEK_SOURCE="${PYCHESTRATE_KEK_SOURCE:-file}"
export PYCHESTRATE_KEK_ID="${PYCHESTRATE_KEK_ID:-staging-kek-1}"
export PYCHESTRATE_KEK_FILE_PATH="${PYCHESTRATE_KEK_FILE_PATH:-${KEK_FILE}}"

export PYCHESTRATE_ENVELOPE_SIGNING_KEY_SOURCE="${PYCHESTRATE_ENVELOPE_SIGNING_KEY_SOURCE:-file}"
export PYCHESTRATE_ENVELOPE_SIGNING_KEY_ID="${PYCHESTRATE_ENVELOPE_SIGNING_KEY_ID:-staging-envelope-ed25519-1}"
export PYCHESTRATE_ENVELOPE_SIGNING_KEY_FILE_PATH="${PYCHESTRATE_ENVELOPE_SIGNING_KEY_FILE_PATH:-${ENVELOPE_SIGNING_KEY_FILE}}"

export PYCHESTRATE_PASSWORD_PEPPER_SOURCE="${PYCHESTRATE_PASSWORD_PEPPER_SOURCE:-file}"
export PYCHESTRATE_PASSWORD_PEPPER_FILE_PATH="${PYCHESTRATE_PASSWORD_PEPPER_FILE_PATH:-${PEPPER_FILE}}"

export PYCHESTRATE_UI_COOKIE_SECRET_SOURCE="${PYCHESTRATE_UI_COOKIE_SECRET_SOURCE:-file}"
export PYCHESTRATE_UI_COOKIE_SECRET_FILE_PATH="${PYCHESTRATE_UI_COOKIE_SECRET_FILE_PATH:-${UI_COOKIE_SECRET_FILE}}"

export PYCHESTRATE_METRICS_TOKEN_FILE="${PYCHESTRATE_METRICS_TOKEN_FILE:-${METRICS_TOKEN_FILE}}"

export PYCHESTRATE_BIND_HOST="${PYCHESTRATE_BIND_HOST:-127.0.0.1}"
export PYCHESTRATE_BIND_PORT="${PYCHESTRATE_BIND_PORT:-8888}"
export PYCHESTRATE_WORKERS="${PYCHESTRATE_WORKERS:-4}"
export PYCHESTRATE_THREADS="${PYCHESTRATE_THREADS:-2}"

# ----------------------------------------------------------------------------
# PYTHONPATH (mirrors dev-up + run-website.sh)
# ----------------------------------------------------------------------------

export PYTHONPATH="${REPO_ROOT}/source/packages:${REPO_ROOT}/source/site:${PYTHONPATH:-}"

echo "run-staging-gunicorn: env=${PYCHESTRATE_RUNTIME_ENVIRONMENT}"
echo "run-staging-gunicorn: db=${PYCHESTRATE_DATABASE_URL:-<persona default sqlite:///${DEV_DB_PATH}>}"
echo "run-staging-gunicorn: bind=${PYCHESTRATE_BIND_HOST}:${PYCHESTRATE_BIND_PORT}"
echo "run-staging-gunicorn: workers=${PYCHESTRATE_WORKERS} threads=${PYCHESTRATE_THREADS}"
echo "run-staging-gunicorn: kek=${PYCHESTRATE_KEK_FILE_PATH}"
echo

# ----------------------------------------------------------------------------
# Admin mode: run the operator command line instead of gunicorn
# ----------------------------------------------------------------------------

if [[ "${ADMIN_MODE}" == "true" ]]; then
    if [[ -x "${REPO_ROOT}/.venv/bin/python" ]]; then
        PYTHON="${REPO_ROOT}/.venv/bin/python"
    else
        PYTHON="$(command -v python3)"
    fi
    exec "${PYTHON}" -m ccai.pychestrate.admin "$@"
fi

# ----------------------------------------------------------------------------
# Locate gunicorn (prefer the venv's, fall back to PATH)
# ----------------------------------------------------------------------------

if [[ -x "${REPO_ROOT}/.venv/bin/gunicorn" ]]; then
    GUNICORN="${REPO_ROOT}/.venv/bin/gunicorn"
else
    GUNICORN="$(command -v gunicorn || echo "")"
fi

if [[ -z "${GUNICORN}" ]]; then
    echo "ERROR: gunicorn not found in .venv/bin/ or PATH." >&2
    echo "       Run 'poetry install' to install it (it is a direct dep)." >&2
    exit 2
fi

# ----------------------------------------------------------------------------
# exec gunicorn -- the WSGI factory in app_pychestrate_main returns
# the build-for-production WSGI app.
# ----------------------------------------------------------------------------

exec "${GUNICORN}" 'app_pychestrate_main:build_wsgi_application_for_production()' \
    --chdir "${REPO_ROOT}/source/site" \
    --bind "${PYCHESTRATE_BIND_HOST}:${PYCHESTRATE_BIND_PORT}" \
    --workers "${PYCHESTRATE_WORKERS}" \
    --threads "${PYCHESTRATE_THREADS}" \
    --access-logfile - \
    --error-logfile - \
    --capture-output
