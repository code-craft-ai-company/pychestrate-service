# Pychestrate webservice — sample operator environment
#
# Copy this to a real .env (or otherwise export the values) before running
# the production entry points (`make serve-prod` /
# `make serve-prod-gunicorn`). For local development, prefer `make dev-up`
# which generates safe defaults under .cache/dev-secrets/ rather than
# requiring this file.
#
# All variables are read by
# source/site/ccai/pychestrate/webservice/runtime_bootstrap.py.

# --- Required ---------------------------------------------------------------

# SQLAlchemy database URL.
PYCHESTRATE_DATABASE_URL=postgresql+psycopg://pychestrate:CHANGEME@db.internal:5432/pychestrate

# One of: development | staging | production | testing.
# AUTO_CREATE_SCHEMA is refused when this is "production".
PYCHESTRATE_RUNTIME_ENVIRONMENT=production

# KEK (Key Encryption Key) source — "file" or "env".
PYCHESTRATE_KEK_SOURCE=file
# Operator-assigned identifier for the active KEK (logged at startup).
PYCHESTRATE_KEK_ID=prod-kek-rotation-2026-q2

# When KEK_SOURCE=file:
PYCHESTRATE_KEK_FILE_PATH=/etc/pychestrate/keys/active.kek
# When KEK_SOURCE=env, set:
#   PYCHESTRATE_KEK_ENV_VAR=PYCHESTRATE_KEK_MATERIAL
#   PYCHESTRATE_KEK_MATERIAL=<base64-or-raw-bytes here>

# --- Optional ---------------------------------------------------------------

# Password pepper for Argon2id verification. Skip to leave auth disabled
# during initial bring-up; the auth flow will then 503 on password verify.
PYCHESTRATE_PASSWORD_PEPPER_SOURCE=file
PYCHESTRATE_PASSWORD_PEPPER_FILE_PATH=/etc/pychestrate/keys/password-pepper

# UI cookie signing secret for the consumer-facing /config web UI.
# Skip to leave the web UI unwired (REST surface continues to serve).
# Material must be at least 32 bytes when present.
PYCHESTRATE_UI_COOKIE_SECRET_SOURCE=file
PYCHESTRATE_UI_COOKIE_SECRET_FILE_PATH=/etc/pychestrate/keys/ui-cookie-secret
# When _SOURCE=env, set:
#   PYCHESTRATE_UI_COOKIE_SECRET_ENV_VAR=PYCHESTRATE_UI_COOKIE_SECRET_MATERIAL
#   PYCHESTRATE_UI_COOKIE_SECRET_MATERIAL=<32+ bytes here>

# Auto-create the SQLAlchemy schema at boot. Refused in production —
# production uses out-of-band migrations.
PYCHESTRATE_AUTO_CREATE_SCHEMA=false

# Bind / worker tuning for the built-in webworks WSGI server. The
# gunicorn target reads these for its --bind / --workers / --threads.
PYCHESTRATE_BIND_HOST=0.0.0.0
PYCHESTRATE_BIND_PORT=8888
PYCHESTRATE_WORKERS=4
PYCHESTRATE_THREADS=2

# Echo every SQL statement to stderr (debugging only).
PYCHESTRATE_SQL_ECHO=false

# --- Test mode (OFF by default; REFUSED in production) -----------------------
# When enabled in a non-production environment, the runtime seeds / resets a
# known admin credential at boot and marks the setup wizard complete, so the
# live-deploy test suites (and a local smoke session) can authenticate
# deterministically. NEVER enable on an internet-facing instance — it injects a
# backdoor admin from these variables by design.
#
# Point the live-deploy suites at such an instance with:
#   PYCHESTRATE_TEST_BASE_URL=http://localhost:8888
#   PYCHESTRATE_TEST_ADMIN_LOGIN / ..._PASSWORD matching the values below.
PYCHESTRATE_TEST_MODE=false
# PYCHESTRATE_TEST_ADMIN_LOGIN=admin
# PYCHESTRATE_TEST_ADMIN_EMAIL=admin@example.com
# PYCHESTRATE_TEST_ADMIN_PASSWORD=<required when test mode is on>
# PYCHESTRATE_TEST_ADMIN_DISPLAY_NAME=Test Admin

# --- Job execution loop (pods enroll, receive signed jobs, upload results) ---
# Without these the UI and REST API work but no job can complete. The
# System Health page ("Job Execution Loop") shows which ones are missing.
# development/dev-up and development/run-staging-gunicorn generate all of
# them under .cache/dev-secrets/ when unset.

# Ed25519 key every dispatched job envelope is signed with; pods verify it.
# The file holds a base64-encoded 32-byte seed:
#   head -c 32 /dev/urandom | base64 > envelope-signing-key
# Unset => every dispatch fails ("no envelope signing key is installed").
PYCHESTRATE_ENVELOPE_SIGNING_KEY_SOURCE=file
PYCHESTRATE_ENVELOPE_SIGNING_KEY_FILE_PATH=/etc/pychestrate/keys/envelope-signing-key
PYCHESTRATE_ENVELOPE_SIGNING_KEY_ID=prod-envelope-ed25519-1

# Client-enrollment CA: signs each pod's client certificate at enrollment
# (CN = the pod's client id). One PEM file with the CA certificate AND its
# private key. The TLS terminator in front of the service must verify client
# certificates against this CA's certificate (nginx ssl_client_certificate).
# Unset => POST /api/v1/enrollment-tokens/redeem answers 503.
PYCHESTRATE_ENROLLMENT_CA_SOURCE=file
PYCHESTRATE_ENROLLMENT_CA_FILE_PATH=/etc/pychestrate/keys/enrollment-ca.pem
PYCHESTRATE_ENROLLMENT_CA_ID=prod-enrollment-ca-1

# HMAC secret for presigned result-upload URLs, shared by every worker.
# Unset => each worker process uses its own random secret and an upload that
# lands on another worker is rejected.
PYCHESTRATE_RESULT_PRESIGN_SECRET=CHANGEME-32-or-more-random-characters

# Proxies whose X-Client-Cert-CN / X-Client-Cert-Verify headers are trusted
# to carry a pod's verified client certificate (IPs / CIDRs, comma
# separated). Default 127.0.0.1,::1 (nginx on the same host); "none" trusts
# no proxy.
PYCHESTRATE_TRUSTED_PROXY_ADDRESSES=127.0.0.1,::1
