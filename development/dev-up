#!/usr/bin/env bash
#
# Boot a SQLite-backed local Pychestrate webservice for smoke-testing.
#
# Generates every per-checkout dev secret a first run needs under
# .cache/dev-secrets/ (gitignored, mode 0600): KEK, password pepper, UI
# cookie secret, the client-enrollment CA (pods enroll against it), the
# job-envelope signing key (every dispatch is signed with it) and the
# result-upload presign secret. Starts the service with
# PYCHESTRATE_AUTO_CREATE_SCHEMA=true so the empty SQLite file is populated
# on first boot. Subsequent runs reuse the same SQLite file and the same dev
# secrets. Any PYCHESTRATE_* variable already set in the environment wins
# over the generated default.
#
# Refuses to run with PYCHESTRATE_RUNTIME_ENVIRONMENT=production so an
# operator who copy-pastes never accidentally points this at a real database.

set -euo pipefail

cd "$(dirname "$0")/.."
REPO_ROOT="$(pwd)"

# ----------------------------------------------------------------------------
# Refuse production
# ----------------------------------------------------------------------------

if [[ "${PYCHESTRATE_RUNTIME_ENVIRONMENT:-}" == "production" ]]; then
    echo "dev-up refuses to run with PYCHESTRATE_RUNTIME_ENVIRONMENT=production." >&2
    echo "Unset the variable or set it to development/staging/testing." >&2
    exit 1
fi

# ----------------------------------------------------------------------------
# Per-checkout dev secret material (KEK + pepper)
# ----------------------------------------------------------------------------

SECRETS_DIR="${REPO_ROOT}/.cache/dev-secrets"
mkdir -p "${SECRETS_DIR}"

KEK_FILE="${SECRETS_DIR}/dev.kek"
PEPPER_FILE="${SECRETS_DIR}/dev.password-pepper"
UI_COOKIE_SECRET_FILE="${SECRETS_DIR}/dev.ui-cookie-secret"
ENROLLMENT_CA_FILE="${SECRETS_DIR}/dev.enrollment-ca.pem"
# Public half of the enrollment CA, for a local TLS terminator
# (nginx ``ssl_client_certificate``) that verifies pod certificates.
ENROLLMENT_CA_CERT_FILE="${SECRETS_DIR}/dev.enrollment-ca.crt"
# Base64-encoded 32-byte Ed25519 seed for the job-envelope signer
# (same format as development/run-staging-gunicorn). The loader
# (jobs/envelope/signer.py) decodes base64 then builds the Ed25519
# private key from the seed.
ENVELOPE_SIGNING_KEY_FILE="${SECRETS_DIR}/dev.envelope-signing-key"
# HMAC secret for presigned result-upload URLs; shared by every
# worker so an upload may land on a different worker than the
# presign call.
RESULT_PRESIGN_SECRET_FILE="${SECRETS_DIR}/dev.result-presign-secret"

if [[ ! -s "${KEK_FILE}" ]]; then
    head -c 32 /dev/urandom > "${KEK_FILE}"
    chmod 600 "${KEK_FILE}"
    echo "dev-up: generated ${KEK_FILE} (32 random bytes)"
fi

if [[ ! -s "${PEPPER_FILE}" ]]; then
    head -c 32 /dev/urandom > "${PEPPER_FILE}"
    chmod 600 "${PEPPER_FILE}"
    echo "dev-up: generated ${PEPPER_FILE} (32 random bytes)"
fi

if [[ ! -s "${UI_COOKIE_SECRET_FILE}" ]]; then
    head -c 32 /dev/urandom > "${UI_COOKIE_SECRET_FILE}"
    chmod 600 "${UI_COOKIE_SECRET_FILE}"
    echo "dev-up: generated ${UI_COOKIE_SECRET_FILE} (32 random bytes)"
fi

# Self-signed client-enrollment CA. This signs the client
# certificates minted by POST /enrollment-tokens/redeem; without it
# that route answers 503 and no pod can enroll locally. Cert and key
# are concatenated into one PEM because that is what
# ``ca_adapter.load_ca_at_startup`` reads.
if [[ ! -s "${ENROLLMENT_CA_FILE}" ]]; then
    CA_TMP="$(mktemp -d)"
    openssl req -x509 -newkey rsa:2048 -nodes \
        -keyout "${CA_TMP}/ca.key" -out "${CA_TMP}/ca.crt" \
        -days 3650 -subj "/CN=pychestrate-dev-enrollment-ca" \
        >/dev/null 2>&1
    cat "${CA_TMP}/ca.crt" "${CA_TMP}/ca.key" > "${ENROLLMENT_CA_FILE}"
    chmod 600 "${ENROLLMENT_CA_FILE}"
    rm -rf "${CA_TMP}"
    echo "dev-up: generated ${ENROLLMENT_CA_FILE} (self-signed dev CA)"
fi

if [[ ! -s "${ENROLLMENT_CA_CERT_FILE}" ]]; then
    openssl x509 -in "${ENROLLMENT_CA_FILE}" -out "${ENROLLMENT_CA_CERT_FILE}"
    chmod 644 "${ENROLLMENT_CA_CERT_FILE}"
    echo "dev-up: wrote ${ENROLLMENT_CA_CERT_FILE} (enrollment CA certificate for a TLS terminator)"
fi

if [[ ! -s "${ENVELOPE_SIGNING_KEY_FILE}" ]]; then
    head -c 32 /dev/urandom | base64 > "${ENVELOPE_SIGNING_KEY_FILE}"
    chmod 600 "${ENVELOPE_SIGNING_KEY_FILE}"
    echo "dev-up: generated ${ENVELOPE_SIGNING_KEY_FILE} (base64 Ed25519 seed)"
fi

if [[ ! -s "${RESULT_PRESIGN_SECRET_FILE}" ]]; then
    head -c 32 /dev/urandom | base64 > "${RESULT_PRESIGN_SECRET_FILE}"
    chmod 600 "${RESULT_PRESIGN_SECRET_FILE}"
    echo "dev-up: generated ${RESULT_PRESIGN_SECRET_FILE} (32 random bytes, base64)"
fi

# ----------------------------------------------------------------------------
# SQLite dev DB
# ----------------------------------------------------------------------------

DEV_DB_DIR="${REPO_ROOT}/.cache/dev-db"
mkdir -p "${DEV_DB_DIR}"
DEV_DB_PATH="${DEV_DB_DIR}/pychestrate.sqlite"

# Per-checkout presence dir for dev runs. Holds the setup
# wizard's initial-admin-token, the SQLite DB, and (eventually)
# settings.config + logs/. Under .cache/ so ``rm -rf .cache``
# resets dev state cleanly without touching anyone's real
# ~/pychestrate/ if they happen to be running a deploy on the
# same machine.
DEV_PRESENCE_DIR="${REPO_ROOT}/.cache/presence"
mkdir -p "${DEV_PRESENCE_DIR}"
chmod 0700 "${DEV_PRESENCE_DIR}"

# ----------------------------------------------------------------------------
# Compose the runtime env from documented PYCHESTRATE_* names
# ----------------------------------------------------------------------------

export PYCHESTRATE_RUNTIME_ENVIRONMENT="${PYCHESTRATE_RUNTIME_ENVIRONMENT:-development}"
# PYCHESTRATE_DATABASE_URL is now optional -- the persona-derived
# default (DATASTORAGE section in pychestrate_variables.py)
# computes ``sqlite:///<presence-dir>/pychestrate.sqlite``, so the
# DB ends up alongside the wizard token in ``.cache/presence/``.
# Override here if you want a different DB URL (e.g. Postgres).
#export PYCHESTRATE_DATABASE_URL="sqlite:///${DEV_PRESENCE_DIR}/pychestrate.sqlite"
export PYCHESTRATE_AUTO_CREATE_SCHEMA="${PYCHESTRATE_AUTO_CREATE_SCHEMA:-true}"

export PYCHESTRATE_KEK_SOURCE="${PYCHESTRATE_KEK_SOURCE:-file}"
export PYCHESTRATE_KEK_ID="${PYCHESTRATE_KEK_ID:-dev-kek-1}"
export PYCHESTRATE_KEK_FILE_PATH="${PYCHESTRATE_KEK_FILE_PATH:-${KEK_FILE}}"

export PYCHESTRATE_PASSWORD_PEPPER_SOURCE="${PYCHESTRATE_PASSWORD_PEPPER_SOURCE:-file}"
export PYCHESTRATE_PASSWORD_PEPPER_FILE_PATH="${PYCHESTRATE_PASSWORD_PEPPER_FILE_PATH:-${PEPPER_FILE}}"

export PYCHESTRATE_UI_COOKIE_SECRET_SOURCE="${PYCHESTRATE_UI_COOKIE_SECRET_SOURCE:-file}"
export PYCHESTRATE_UI_COOKIE_SECRET_FILE_PATH="${PYCHESTRATE_UI_COOKIE_SECRET_FILE_PATH:-${UI_COOKIE_SECRET_FILE}}"

export PYCHESTRATE_ENROLLMENT_CA_SOURCE="${PYCHESTRATE_ENROLLMENT_CA_SOURCE:-file}"
export PYCHESTRATE_ENROLLMENT_CA_FILE_PATH="${PYCHESTRATE_ENROLLMENT_CA_FILE_PATH:-${ENROLLMENT_CA_FILE}}"
export PYCHESTRATE_ENROLLMENT_CA_ID="${PYCHESTRATE_ENROLLMENT_CA_ID:-dev-enrollment-ca-1}"

export PYCHESTRATE_ENVELOPE_SIGNING_KEY_SOURCE="${PYCHESTRATE_ENVELOPE_SIGNING_KEY_SOURCE:-file}"
export PYCHESTRATE_ENVELOPE_SIGNING_KEY_ID="${PYCHESTRATE_ENVELOPE_SIGNING_KEY_ID:-dev-envelope-ed25519-1}"
export PYCHESTRATE_ENVELOPE_SIGNING_KEY_FILE_PATH="${PYCHESTRATE_ENVELOPE_SIGNING_KEY_FILE_PATH:-${ENVELOPE_SIGNING_KEY_FILE}}"

export PYCHESTRATE_RESULT_PRESIGN_SECRET="${PYCHESTRATE_RESULT_PRESIGN_SECRET:-$(cat "${RESULT_PRESIGN_SECRET_FILE}")}"

export PYCHESTRATE_BIND_HOST="${PYCHESTRATE_BIND_HOST:-127.0.0.1}"
export PYCHESTRATE_BIND_PORT="${PYCHESTRATE_BIND_PORT:-8888}"
# One worker process (the pod dispatch queue lives in process
# memory) serving requests on a pool of threads: a browser loads a
# page's assets in parallel and a pod's 30 s dispatch long-poll
# holds only one thread.
export PYCHESTRATE_WORKERS="${PYCHESTRATE_WORKERS:-1}"
export PYCHESTRATE_THREADS="${PYCHESTRATE_THREADS:-8}"

export PYCHESTRATE_PRESENCE_DIR="${PYCHESTRATE_PRESENCE_DIR:-${DEV_PRESENCE_DIR}}"

# ----------------------------------------------------------------------------
# PYTHONPATH (mirrors development/run-website.sh)
# ----------------------------------------------------------------------------

export PYTHONPATH="${REPO_ROOT}/source/packages:${REPO_ROOT}/source/site:../codecraftai-webworks/source/packages:../codecraftai-this-app/source/packages:../codecraftai-testbase/source/packages:../codecraftai-configuration/source/packages:../codecraftai-credentials/source/packages:../codecraftai-dataprofiles/source/packages:../codecraftai-errors/source/packages:../pychestrate-core/source/packages:${PYTHONPATH:-}"

echo "dev-up: env=${PYCHESTRATE_RUNTIME_ENVIRONMENT}"
echo "dev-up: db=${PYCHESTRATE_DATABASE_URL:-<persona default>}"
echo "dev-up: bind=${PYCHESTRATE_BIND_HOST}:${PYCHESTRATE_BIND_PORT}"
echo "dev-up: workers=${PYCHESTRATE_WORKERS} threads=${PYCHESTRATE_THREADS}"
echo "dev-up: kek=${PYCHESTRATE_KEK_FILE_PATH}"
echo "dev-up: pepper=${PYCHESTRATE_PASSWORD_PEPPER_FILE_PATH}"
echo "dev-up: ui-cookie-secret=${PYCHESTRATE_UI_COOKIE_SECRET_FILE_PATH}"
echo "dev-up: enrollment-ca=${PYCHESTRATE_ENROLLMENT_CA_FILE_PATH}"
echo "dev-up: enrollment-ca-cert=${ENROLLMENT_CA_CERT_FILE}"
echo "dev-up: envelope-signing-key=${PYCHESTRATE_ENVELOPE_SIGNING_KEY_FILE_PATH} (id ${PYCHESTRATE_ENVELOPE_SIGNING_KEY_ID})"
echo "dev-up: result-presign-secret=${RESULT_PRESIGN_SECRET_FILE}"
echo "dev-up: presence-dir=${PYCHESTRATE_PRESENCE_DIR}"
echo

if [[ -f "${REPO_ROOT}/.venv/bin/python" ]]; then
    PYTHON="${REPO_ROOT}/.venv/bin/python"
else
    PYTHON="$(command -v python3 || command -v python)"
fi

exec "${PYTHON}" source/site/app_pychestrate_main.py
