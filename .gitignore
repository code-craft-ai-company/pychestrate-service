# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
# Source-tree exception: the Layer-6 build orchestration package
# is a Python sub-module under orchestration/, not a build-output
# directory.
!source/site/ccai/pychestrate/webservice/orchestration/build/
!source/site/ccai/pychestrate/webservice/orchestration/build/**
# Keep cache + bytecode out of the unignored sub-tree.
source/site/ccai/pychestrate/webservice/orchestration/build/**/__pycache__/
develop-eggs/
dist/
# Source-tree exception: the prebuilt frontend bundles emitted by
# the frontend/ TypeScript toolchain are checked in so the Python
# deploy does not need Node. See frontend/README.md for policy.
!source/site/ccai/pychestrate/webservice/webinterface/static/javascript/dist/
!source/site/ccai/pychestrate/webservice/webinterface/static/javascript/dist/**
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

