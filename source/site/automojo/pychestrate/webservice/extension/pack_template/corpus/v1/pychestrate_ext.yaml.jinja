# Pychestrate extension manifest.
#
# Layer E loads packs by walking installed Python packages, finding
# this manifest, and validating the declared protocols against the
# host's compat surface. See the Layer E docs for the full schema.
name: {{ name }}
version: 0.1.0
{% if author -%}
author: "{{ author }}"
{% endif -%}
{% if license -%}
license: {{ license }}
{% endif -%}
min_service_version: 1
max_service_version: 1
factory_protocols:
{% for proto in protocol_names -%}
  - name: {{ proto }}
    implementation: automojo.factories.pychestrate.{{ name | replace("-", "_") }}.sample_factory
{% else -%}
  []
{% endfor -%}
resource_extensions:
{% for base in resource_base_names -%}
  - base: {{ base }}
    module: automojo.extensions.pychestrate.{{ name | replace("-", "_") }}.sample_resource
{% else -%}
  []
{% endfor -%}
capabilities:
  read:secrets: false
  write:artifacts: false
  dispatch:jobs: false
  net:outbound: false
  process:subprocess: false
