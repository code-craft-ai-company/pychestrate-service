                            "086: def test_admin_dashboard_renders_inside_site_shell():",
                            "087:     \"\"\"",
                            "088:     **Feature: site-shell + admin-ui**",
                            "089:     **Property: After a successful admin login, GET /admin/dashboard",
                            "090:     returns an HTML page that mounts the ``<pyc-site-shell>`` Custom",
                            "091:     Element AND imports the ``pyc-admin-bundle.js`` script so the",
                            "092:     admin sidebar group registers in the browser.**",
                            "093:     \"\"\"",
                            "094:     login_name, password = _resolve_admin_credentials()",
                            "095: ",
                            "096:     with httpx.Client(",
                            "097:             base_url=BASE_URL,",
                            "098:             timeout=REQUEST_TIMEOUT_SECONDS,",
                            "099:             follow_redirects=True,",
                            "100:         ) as client:",
                            "101:         # Mint a session cookie.",
                            "102:         client.get(\"/login\")",
                            "103:         login_response = client.post(",
                            "104:             \"/login\",",
                            "105:             data={\"username\": login_name, \"password\": password},",
                            "106:         )",
                            "107:         testbase.assert_equal(login_response.status_code, 200)",
                            "108: ",
                            "109:         # Fetch the admin dashboard with the cookie jar populated.",
                            "110:         response = client.get(\"/admin/dashboard\")",
                            "111: ",
                            "112:     testbase.assert_equal(response.status_code, 200)",
                            "113:     content_type = response.headers.get(\"content-type\", \"\")",
                            "114:     testbase.assert_true(\"text/html\" in content_type)",
                            "115: ",
                            "116:     body = response.text",
                            "117:     # Renders inside the shell, not the old standalone admin HTML.",
                            "118:     testbase.assert_true(\"<pyc-site-shell\" in body)",
                            "119:     # The admin bundle <script> tag is present so the sidebar",
                            "120:     # registration runs on this navigation.",
                            "121:     testbase.assert_true(",
                            "122:         \"/static/javascript/dist/pyc-admin-bundle.js\" in body",
